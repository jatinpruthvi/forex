//| from EA_CF_AMD_Model.mq5  |  magic 3201  |  AMD Model
//==================================================================
//--- EA_CF_AMD_Model.mq5 (magic 3201)
const string                 P3201_InpSymbolsToTrade            = "US100,US500,GER40";
const ulong                  P3201_InpMagicNumber               = 3201;
const double                 P3201_InpRiskPct                   = 0.50;
const int                    P3201_InpStage                     = 5;
const double                 P3201_InpMaxSpreadPoints           = 3.0;
const double                 P3201_InpDailyLossPct              = 1.50;
const int                    P3201_InpServerGmtOffset           = 2;
const ENUM_EA_LOG_LEVEL      P3201_InpLogLevel                  = EA_LOG_EVENTS;
const double                 P3201_InpCommissionPerLotRT        = 0.0;
const double                 P3201_InpMaxCostR                  = 0.12;
const bool                   P3201_InpLedger                    = true;
const int                    P3201_InpRangeFromMin              = 0;
const int                    P3201_InpRangeToMin                = 870;
const int                    P3201_InpMacro1FromMin             = 890;
const int                    P3201_InpMacro1ToMin               = 910;
const int                    P3201_InpMacro2FromMin             = 950;
const int                    P3201_InpMacro2ToMin               = 970;
const bool                   P3201_InpMacroWindowsOnly          = true;
const int                    P3201_InpReclaimWindowBars         = 3;
const double                 P3201_InpSweepMinAtr               = 0.05;
const double                 P3201_InpSweepMaxAtr               = 1.20;
const double                 P3201_InpEntryRetrace              = 0.50;
const double                 P3201_InpStopBufferAtr             = 0.10;
const double                 P3201_InpMinStopAtr                = 0.20;
const double                 P3201_InpMaxStopAtr                = 2.50;
const double                 P3201_InpTargetR                   = 2.00;
const bool                   P3201_InpRequireHtfAlign           = true;
const bool                   P3201_InpRequireCorrelation        = true;
const string                 P3201_InpCorrelationSymbol         = "US500";
const double                 P3201_InpMinTargetR                = 1.00;

//--- identity / risk
  // Universe (the playbook trades NQ / ES)
                 // UNIQUE MAGIC NUMBER FOR THIS STRATEGY
                 // Risk per trade (% of equity)
                    // 5-Stage framework stage (1 novice .. 5 pro; 5 = policy off)
                  // Spread gate in points (0 = off)
                 // Halt for the day at -x% (0 = off)
                    // Broker server clock minus GMT (winter)
        // Log verbosity
                // Round-turn commission per lot (engine cost gate)
               // Reject setups whose all-in cost exceeds xR
               // Write the engine evidence ledger CSV
//--- AMD structure (clock minutes on the London wall clock; New York = London - 5)
      // Accumulation window start (00:00 London)
    // Accumulation window end   (14:30 London = NY open)
    // 14:50 London = 09:50 ET
    // 15:10 London = 10:10 ET
    // 15:50 London = 10:50 ET
    // 16:10 London = 11:10 ET
   // Respect the playbook's two macro windows
      // Max bars from the sweep to the reclaim
   // Min sweep depth in ATR
   // Max sweep depth in ATR (0 = unlimited)
   // Limit at 50% of the displacement body (the imbalance)
   // Stop buffer beyond the manipulation extreme
   // Reject if the stop is tighter than this
   // Reject if the stop is wider than this
   // Target in R (opposite side of the accumulation range)
   // 1H + D1 must agree with the trade (playbook's HTF clarity)
  // "related markets are aligned" gate (NASDAQ vs S&P)
 // [interpretation] the twin; '' or the same symbol = gate off
   // A structural target must be at least this far to be used

//+------------------------------------------------------------------+
//| Strategy class                                                   |
//+------------------------------------------------------------------+
class P3201_CCfAmdModel : public CEAStrategy
{
public:
   void OnInitStrategy()
   {
      EA_Log(EA_LOG_EVENTS, StringFormat("5-stage policy: stage %d active (risk %.3f%%, %d trades/day max)",
             P3201_InpStage, g_eaCfg.riskPct, g_eaCfg.maxTradesPerDay), true);
   }

   void Configure(SEASettings &cfg)
   {
      cfg.strategyName          = "CF_AMD_MODEL";
      cfg.sourceDoc             = "chartfanatics/pdf/amd-model.pdf (card #04)";
      cfg.symbols               = P3201_InpSymbolsToTrade;
      cfg.magic                 = P3201_InpMagicNumber;
      cfg.riskPct               = P3201_InpRiskPct;
      cfg.signalTimeframe       = PERIOD_M5;
      cfg.clock                 = EA_CLOCK_LONDON;
      cfg.serverWinterGmtOffset = P3201_InpServerGmtOffset;
      cfg.maxSpreadPoints       = P3201_InpMaxSpreadPoints;
      cfg.dailyLossPct          = P3201_InpDailyLossPct;
      cfg.weeklyLossPct         = 3.0;
      cfg.totalDdPct            = 8.0;
      cfg.maxTradesPerDay       = 2;      // "limit yourself to two trades per session"
      cfg.dayLockAfterLosses    = 2;      // "if you take two losses, step away for the day"
      cfg.maxOpenPositions      = 1;
      cfg.minSecondsBetweenTrades = 120;
      cfg.useHwmThrottle        = true;
      cfg.hwmTier1Dd            = 2.0;  cfg.hwmTier1Mult = 0.50;
      cfg.hwmTier2Dd            = 4.0;  cfg.hwmTier2Mult = 0.25;
      cfg.hwmHaltDd             = 6.0;
      cfg.sessionStartHour      = 14;  cfg.sessionStartMin = 40;   // 09:40 ET - before macro window 1
      cfg.sessionEndHour        = 16;  cfg.sessionEndMin   = 20;   // 11:20 ET - after macro window 2
      cfg.noTradeAfterHour      = 17;  cfg.noTradeAfterMin = 0;
      cfg.fridayFlat            = true;  cfg.fridayFlatHour = 19;  cfg.fridayFlatMin = 0;
      cfg.signalOnNewBarOnly    = true;
      cfg.useLimitEntry         = true;
      cfg.pendingExpiryMinutes  = 15;      // three M5 candles for the retrace to appear
      cfg.breakEvenAtR          = 1.0;
      cfg.partial1AtR           = 1.0;  cfg.partial1Pct = 50.0;     // "take partial profits at logical targets"
      cfg.trailAtR              = 1.5;  cfg.trailDistanceR = 0.75;
      cfg.commissionPerLotRT    = P3201_InpCommissionPerLotRT;
      cfg.maxCostR              = P3201_InpMaxCostR;             // engine cost gate: (spread + commission) <= xR
      cfg.ledgerEnabled         = P3201_InpLedger;               // engine ledger: one row per open / partial / close
      cfg.ledgerFile            = "cf_amd_model_ledger.csv";
      cfg.newsFilter            = false;   // the playbook's best setups ARE the post-news moves
      cfg.logLevel              = P3201_InpLogLevel;

      //--- chartfanatics card #01 (5-Stage framework): tighten the playbook's own risk posture for
      //--- the stage the account is being held to.  Never raises a cap; stage 5 leaves it untouched.
      EA_ApplyStagePolicy(cfg, P3201_InpStage);
   }

   bool BuildPlan(SEAContext &ctx, SSignalPlan &plan)
   {
      plan.Reset();
      if(!ctx.inSession) return false;
      if(ctx.atr <= 0.0) return false;
      if(P3201_InpMacroWindowsOnly && !InMacroWindow(ctx)) return false;

      SSweepParams p;
      p.Reset();
      p.rangeFromMin        = P3201_InpRangeFromMin;
      p.rangeToMin          = P3201_InpRangeToMin;
      p.sessionFromMin      = P3201_InpMacro1FromMin;
      p.sessionToMin        = P3201_InpMacro2ToMin;
      p.sweepMinAtr         = P3201_InpSweepMinAtr;
      p.sweepMaxAtr         = P3201_InpSweepMaxAtr;
      p.reclaimWindowBars   = P3201_InpReclaimWindowBars;
      p.wickRatio           = 0.55;         // the manipulation candle must reject the range
      p.bodyRatio           = 0.60;         // displacement body ("breaks with intent")
      p.stopBufferAtr       = P3201_InpStopBufferAtr;
      p.minStopAtr          = P3201_InpMinStopAtr;
      p.maxStopAtr          = P3201_InpMaxStopAtr;
      p.targetR             = P3201_InpTargetR;
      p.entryRetrace        = P3201_InpEntryRetrace;
      p.requireDisplacement = true;
      p.requireMidpointBreak= true;         // the displacement must close beyond the reclaim midpoint
      p.tradeBothWays       = true;
      p.scoreBase           = 62.0;
      if(!SigSweepReclaim(ctx, p, plan)) return false;

      //--- the higher timeframe must be clear, or the playbook says no trade
      if(P3201_InpRequireHtfAlign && plan.dir != HtfBias(ctx))
      {
         plan.Reset();
         return false;
      }

      //--- "Check Market Correlation": the twin market must be positioned the same way
      if(!MarketsAligned(ctx))
      {
         plan.Reset();
         return false;
      }

      //--- "There must be a clear target ... If there's no obvious destination, do not trade."
      //--- The worked example targets the lows underneath the accumulation range, so that side
      //--- of the range is preferred, then the nearest clean swing point; the R target is the
      //--- fallback when neither is far enough to survive the spread.
      double structural = 0.0;
      if(AccumulationTarget(ctx, plan.dir, plan.entry, structural) ||
         NearestSwingTarget(ctx, plan.dir, plan.entry, structural))
      {
         if(MathAbs(structural - plan.entry) / plan.riskDist >= P3201_InpMinTargetR)
         {
            plan.target  = structural;
            plan.reason += " (structural target)";
         }
      }
      plan.reason = "AMD distribution leg: " + plan.reason;
      return true;
   }

private:
   //--- engine window helper (handles the midnight crossing, reads the configured clock)
   bool InMacroWindow(SEAContext &ctx)
   {
      if(EA_InWindow(ctx.nowClock, P3201_InpMacro1FromMin / 60, P3201_InpMacro1FromMin % 60,
                                 P3201_InpMacro1ToMin / 60,   P3201_InpMacro1ToMin % 60)) return true;
      return EA_InWindow(ctx.nowClock, P3201_InpMacro2FromMin / 60, P3201_InpMacro2FromMin % 60,
                                     P3201_InpMacro2ToMin / 60,   P3201_InpMacro2ToMin % 60);
   }

   //--- "Make sure related markets (e.g., NASDAQ and S&P) are aligned.  If they diverge heavily,
   //--- conditions are lower in probability."  [interpretation] "aligned" is read as: both markets
   //--- on the same side of their own previous-day midpoint - the playbook gives no threshold, and
   //--- a symbol the broker does not offer never blocks a trade (fail-open, as everywhere else).
   bool MarketsAligned(SEAContext &ctx)
   {
      if(!P3201_InpRequireCorrelation || StringLen(P3201_InpCorrelationSymbol) == 0) return true;
      if(P3201_InpCorrelationSymbol == ctx.symbol) return true;
      if(!SymbolSelect(P3201_InpCorrelationSymbol, true)) return true;

      double sHi = 0.0, sLo = 0.0, tHi = 0.0, tLo = 0.0;
      int nb = 0;
      if(!SigRangeForDay(ctx.symbol, g_eaIndTf, 0, 1440, 1, sHi, sLo, nb)) return true;
      if(!SigRangeForDay(P3201_InpCorrelationSymbol, g_eaIndTf, 0, 1440, 1, tHi, tLo, nb)) return true;
      double sMid = (sHi + sLo) * 0.5;
      double tMid = (tHi + tLo) * 0.5;
      if(sMid <= 0.0 || tMid <= 0.0) return true;

      double sPx = (ctx.bid > 0.0 && ctx.ask > 0.0) ? (ctx.bid + ctx.ask) * 0.5 : ctx.mid;
      double tPx = SymbolInfoDouble(P3201_InpCorrelationSymbol, SYMBOL_BID);
      if(tPx <= 0.0) return true;
      return ((sPx > sMid) == (tPx > tMid));
   }

   //--- the opposite side of the window that was accumulated, i.e. the playbook example's
   //--- "pre-market lows and equal lows under the range"
   bool AccumulationTarget(SEAContext &ctx, const int dir, const double entry, double &target)
   {
      double hi = 0.0, lo = 0.0;
      int nb = 0;
      if(!SigRangeForDay(ctx.symbol, g_eaIndTf, P3201_InpRangeFromMin, P3201_InpRangeToMin, 0, hi, lo, nb))
         return false;
      double cand = (dir > 0) ? hi : lo;
      if(cand <= 0.0) return false;
      if(dir > 0 && cand <= entry) return false;
      if(dir < 0 && cand >= entry) return false;
      target = cand;
      return true;
   }

   //--- the nearest clean swing point ahead of the entry (the playbook's third target type)
   bool NearestSwingTarget(SEAContext &ctx, const int dir, const double entry, double &target)
   {
      double hi[], lo[];
      int hiIdx[], loIdx[];
      int n = SigFractals(ctx.symbol, 20, hi, lo, hiIdx, loIdx);
      if(n <= 0) return false;
      double best = 0.0;
      double bestDist = DBL_MAX;
      for(int i = 0; i < n; i++)
      {
         double cand = (dir > 0) ? hi[i] : lo[i];
         if(cand <= 0.0) continue;
         double dist = (dir > 0) ? (cand - entry) : (entry - cand);
         if(dist <= 0.0) continue;                 // behind the entry: not a destination
         if(dist < bestDist) { bestDist = dist; best = cand; }
      }
      if(best <= 0.0) return false;
      target = best;
      return true;
   }

   //--- HTF clarity: D1 and H1 200-EMA agreement (the playbook reads 1H/4H/D1, not the M5 signal TF)
   int HtfBias(SEAContext &ctx)
   {
      SCascadeParams c;
      c.Reset();
      c.requireD1           = true;
      c.requireH1           = true;
      c.requireM15Structure = false;
      c.scoreBase           = 60.0;
      return SigEmaCascade(ctx, c);
   }
};

