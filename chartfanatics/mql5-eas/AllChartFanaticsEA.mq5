//| from EA_CF_FirstRedDay.mq5  |  magic 3214  |  First Red Day
//==================================================================
//--- EA_CF_FirstRedDay.mq5 (magic 3214)
const string                 P3214_InpSymbolsToTrade            = "US100,US500,GER40";
const ulong                  P3214_InpMagicNumber               = 3214;
const double                 P3214_InpRiskPct                   = 0.50;
const int                    P3214_InpStage                     = 5;
const double                 P3214_InpMaxSpreadPoints           = 3.0;
const double                 P3214_InpDailyLossPct              = 1.50;
const int                    P3214_InpServerGmtOffset           = 2;
const ENUM_EA_LOG_LEVEL      P3214_InpLogLevel                  = EA_LOG_EVENTS;
const double                 P3214_InpCommissionPerLotRT        = 0.0;
const double                 P3214_InpMaxCostR                  = 0.12;
const bool                   P3214_InpLedger                    = true;
const int                    P3214_InpRunDays                   = 3;
const double                 P3214_InpRunMinPct                 = 25.0;
const bool                   P3214_InpRequireStronger           = true;
const double                 P3214_InpBreakBufferAtr            = 0.05;
const double                 P3214_InpStopBufferAtr             = 0.15;
const bool                   P3214_InpGapDownPath               = true;
const double                 P3214_InpBounceTouchAtr            = 0.50;
const double                 P3214_InpPartial1AtR               = 1.0;
const double                 P3214_InpPartial1Pct               = 50.0;
const double                 P3214_InpTrailAtR                  = 1.5;
const double                 P3214_InpTrailDistR                = 1.0;

//--- identity / risk
  // Instrument selection is the user's universe
                 // UNIQUE MAGIC NUMBER FOR THIS STRATEGY
                 // Risk per trade (% of equity)
                   // 5-Stage framework stage (1 novice .. 5 pro; 5 = policy off)
                  // Spread gate in points (0 = off)
                 // Halt for the day at -x% (0 = off)
                    // Broker server clock minus GMT (winter)
        // Log verbosity
                // Round-turn commission per lot (engine cost gate)
               // Cost gate: (spread + commission) <= xR
               // Write the engine evidence ledger CSV
//--- the run (step 1)
      // "three or more strong days ... one green day is not enough"
   // [interpretation] total run that counts as parabolic (the doc gives no number)
 // "ideally with each day stronger than the last"
//--- the line and the trigger (steps 2-4)
 // A close this far under the line is a confirmed break, not a touch
 // The stop sits just above the line ("never widen the stop")
 // Also take the gap-down path (bounce fails at the line)
 // How close the bounce must come to the line to count as a failure
//--- exits (step 6)
   // "cover portions of your position into the weakness"

   // "hold a small portion ... they often stay weak for days"

//+------------------------------------------------------------------+
class P3214_CCfFirstRedDay : public CEAStrategy
{
public:
   void OnInitStrategy()
   {
      EA_Log(EA_LOG_EVENTS, StringFormat("5-stage policy: stage %d active (risk %.3f%%, %d trades/day max)",
             P3214_InpStage, g_eaCfg.riskPct, g_eaCfg.maxTradesPerDay), true);
      EA_Log(EA_LOG_EVENTS, "first red day armed: >= 3-day run, short the loss of the red-to-green line, stop just above it",
             true);
   }

   void Configure(SEASettings &cfg)
   {
      cfg.strategyName          = "CF_FIRST_RED_DAY";
      cfg.sourceDoc             = "chartfanatics/pdf/first-red-day.pdf (card #10)";
      cfg.symbols               = P3214_InpSymbolsToTrade;
      cfg.magic                 = P3214_InpMagicNumber;
      cfg.riskPct               = P3214_InpRiskPct;
      cfg.signalTimeframe       = PERIOD_M5;
      cfg.clock                 = EA_CLOCK_LONDON;
      cfg.serverWinterGmtOffset = P3214_InpServerGmtOffset;
      cfg.maxSpreadPoints       = P3214_InpMaxSpreadPoints;
      cfg.dailyLossPct          = P3214_InpDailyLossPct;
      cfg.weeklyLossPct         = 3.0;
      cfg.totalDdPct            = 8.0;
      cfg.maxTradesPerDay       = 2;      // a bounce failure may give a second entry, not a third
      //--- [interpretation]: the doc warns that messing up the first trade leads to forcing the next
      //--- (the FOMO con).  One loss therefore ends the day; the run's own second chance is a
      //--- different session.
      cfg.dayLockAfterLosses    = 1;
      cfg.maxOpenPositions      = 1;
      cfg.minSecondsBetweenTrades = 300;
      cfg.sessionStartHour      = 14;  cfg.sessionStartMin = 25;
      cfg.sessionEndHour        = 21;  cfg.sessionEndMin   = 0;
      cfg.noTradeAfterHour      = 20;  cfg.noTradeAfterMin = 0;
      cfg.fridayFlat            = true;  cfg.fridayFlatHour = 20;  cfg.fridayFlatMin = 0;
      cfg.signalOnNewBarOnly    = true;
      cfg.useLimitEntry         = false;                 // "do not anticipate" - the break must happen
      cfg.breakEvenAtR          = 1.0;                   // "hold a position" safely once it works
      cfg.partial1AtR           = P3214_InpPartial1AtR;  cfg.partial1Pct = P3214_InpPartial1Pct;
      cfg.trailAtR              = P3214_InpTrailAtR;     cfg.trailDistanceR = P3214_InpTrailDistR;
      cfg.commissionPerLotRT    = P3214_InpCommissionPerLotRT;
      cfg.maxCostR              = P3214_InpMaxCostR;
      cfg.ledgerEnabled         = P3214_InpLedger;
      cfg.ledgerFile            = "cf_first_red_day_ledger.csv";
      cfg.newsFilter            = false;
      cfg.logLevel              = P3214_InpLogLevel;
      EA_ApplyStagePolicy(cfg, P3214_InpStage);
   }

   bool BuildPlan(SEAContext &ctx, SSignalPlan &plan)
   {
      plan.Reset();
      if(!ctx.inSession || ctx.atr <= 0.0) return false;

      //--- step 1: the multi-day run.  d[1] is yesterday (the last green day of the run), and the
      //--- run must still be the freshest thing on the chart: today is the first red day.
      MqlRates d[];
      if(EA_Rates(ctx.symbol, PERIOD_D1, 0, P3214_InpRunDays + 24, d) < P3214_InpRunDays + 22) return false;

      double runLow = d[1].low;
      bool   stronger = true;
      for(int i = 1; i <= P3214_InpRunDays; i++)
      {
         if(d[i].close <= d[i].open) return false;                 // every day of the run closed green
         runLow = MathMin(runLow, d[i].low);
         if(i < P3214_InpRunDays)
         {
            if(d[i].close <= d[i + 1].close) return false;         // each day closed higher than the previous
            if(P3214_InpRequireStronger && (d[i].close - d[i].open) < (d[i + 1].close - d[i + 1].open))
               stronger = false;                                   // "ideally each day stronger than the last"
         }
      }
      if(!stronger) return false;
      double runStart = d[P3214_InpRunDays].open;
      if(runStart <= 0.0) return false;
      double runPct = (d[1].close - runStart) / runStart * 100.0;
      if(runPct < P3214_InpRunMinPct) return false;                      // "a parabolic move, not a slow trend up"

      double line = d[1].close;                                    // step 2: the red-to-green line

      //--- step 3-4: the trigger.  Never anticipate: the last closed bar must CLOSE below the line.
      MqlRates m[];
      if(EA_Rates(ctx.symbol, g_eaIndTf, 0, 6, m) < 5) return false;
      if(!(m[1].close < m[1].open)) return false;
      if(!(m[1].close < line - P3214_InpBreakBufferAtr * ctx.atr)) return false;

      //--- gap-up path: price pushed higher at the open and faded - the fade is what we are in.
      //--- gap-down path: price is below the line already and the bar is a failed bounce: it rallied
      //--- toward the line and rejected it, so its high must be near (but under) the line.
      bool gapUpFade   = (m[2].high > line) && (m[1].close < line);
      bool gapDownFail = (m[1].high <= line && m[1].high >= line - P3214_InpBounceTouchAtr * ctx.atr);
      if(P3214_InpGapDownPath)
      {
         if(!(gapUpFade || gapDownFail)) return false;
      }
      else if(!gapUpFade) return false;

      //--- step 5: the stop is a reclaim that HOLDS above the line - just above it, never widened
      double entry = ctx.bid;
      double stop  = line + P3214_InpStopBufferAtr * ctx.atr;
      if(stop <= entry) return false;                              // price already reclaimed: no trade
      double risk  = stop - entry;
      if(risk <= 0.0) return false;

      //--- step 6: cover into the weakness, hold a runner; the first target is the run's own low,
      //--- with an R-based fallback so the trade always has a destination.
      double target = runLow;
      if(target >= entry) target = entry - 2.0 * risk;
      if(MathAbs(target - entry) < risk) target = entry - 2.0 * risk;   // keep at least 1R of runway

      plan.dir = -1; plan.entry = entry; plan.stop = stop; plan.riskDist = risk;
      plan.target = target; plan.barsAgo = 1; plan.score = 70.0; plan.isLimit = false;
      plan.reason = StringFormat("first red day: %d-day run (+%.1f%%), lost the line %.2f (%s)",
                                 P3214_InpRunDays, runPct, line, gapUpFade ? "gap-up fade" : "bounce failure");
      return true;
   }
};

