const int                    P3202_InpLegBars                   = 40;
const double                 P3202_InpOteMin                    = 0.62;
const double                 P3202_InpOteMax                    = 0.79;
const bool                   P3202_InpUseOte                    = true;
const bool                   P3202_InpRequireDiscount           = true;
const int                    P3202_InpSessionFromMin            = 420;
const int                    P3202_InpSessionToMin              = 1080;
const int                    P3202_InpPoILookbackBars           = 12;
const double                 P3202_InpDisplacementBody          = 0.55;
const double                 P3202_InpTouchTolAtr               = 0.20;
const int                    P3202_InpReclaimWindowBars         = 3;
const bool                   P3202_InpRequireEngineeredLiquidity = true;
const double                 P3202_InpEntryRetrace              = 0.50;
const double                 P3202_InpStopBufferAtr             = 0.15;
const double                 P3202_InpMinRR                     = 2.00;
const bool                   P3202_InpUseExternalTarget         = true;

//--- identity / risk
  // Universe (playbook: futures / crypto / forex)
