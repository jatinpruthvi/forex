//--- wrapper for EA_CF_MeasuredMove.mq5 (magic 3226)
class P3226_Port : public P3226_CCfMeasuredMove
{
public:
   virtual bool BuildPlan(SEAContext &ctx, SSignalPlan &plan)
   {
