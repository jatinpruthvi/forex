   P3228_CF_WINDOW_ASIA    = 0,   // Asia - "clearer structure and less manipulation" (see header caveat)
   P3228_CF_WINDOW_NEWYORK = 1,   // New York
   P3228_CF_WINDOW_ALL     = 2    // every hour the symbol trades
};

//--- EA_CF_NasdaqIctAndOrderFlowScalpingStrategy.mq5 (magic 3228)
const string                 P3228_InpSymbolsToTrade            = "US100";
const ulong                  P3228_InpMagicNumber               = 3228;
const double                 P3228_InpRiskPct                   = 0.50;
const int                    P3228_InpStage                     = 5;
const int                    P3228_InpServerGmtOffset           = 2;
const ENUM_EA_LOG_LEVEL      P3228_InpLogLevel                  = EA_LOG_EVENTS;
