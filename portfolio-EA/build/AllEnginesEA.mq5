//--- EA_progress  (magic 3113, progress.md - the frozen TRIAD-R Sleeve A contract)
const string                 P3113_InpSymbolsToTrade          = "EURUSD,GBPUSD,USDJPY";
const double                 P3113_InpMaxSpreadPoints         = 3.0;
const double                 P3113_InpDailyLossPct            = 1.0;
const double                 P3113_InpTotalDdPct              = 10;
const double                 P3113_InpProfitTargetPct         = 10;
const int                    P3113_InpMaxTradesPerDay         = 2;
const int                    P3113_InpServerGmtOffset         = 2;
const ulong                  P3113_InpMagicNumber             = 3113;
const ENUM_EA_LOG_LEVEL      P3113_InpLogLevel                = EA_LOG_EVENTS;
const double                 P3113_InpSweepAtrMin             = 0.05;
const double                 P3113_InpSweepAtrMax             = 0.50;
const int                    P3113_InpReclaimBars             = 3;
const double                 P3113_InpReclaimWickMin          = 0.60;
const double                 P3113_InpDisplacementBodyMin     = 0.60;
const double                 P3113_InpStopBufferAtr           = 0.10;
const double                 P3113_InpStopAtrMin              = 0.60;
const double                 P3113_InpStopAtrMax              = 1.50;
const double                 P3113_InpMaxCostToR              = 0.10;
const double                 P3113_InpProfileRiskPct          = 0.40;
const double                 P3113_InpProfileTargetR          = 1.50;
const int                    P3113_InpTimeStopMinutes         = 45;
const string                 P3113_InpBuildId                 = "TRIAD_R_HS_2.1.6_20260905";

//+------------------------------------------------------------------+
//| Strategy: progress.md - the frozen TRIAD-R Sleeve A contract
//+------------------------------------------------------------------+
class P3113_CProgressFrozenContract : public CEAStrategy
{
public:
   void Configure(SEASettings &cfg)
   {
      cfg.strategyName          = "TRIAD_R_FROZEN";
      cfg.sourceDoc             = "docs/strategy/progress.md";
      cfg.symbols               = P3113_InpSymbolsToTrade;
      cfg.magic                 = P3113_InpMagicNumber;
      cfg.riskPct               = P3113_InpProfileRiskPct;         // profile A
      cfg.riskBaseBalance       = true;                      // % of current balance
      cfg.signalTimeframe       = PERIOD_M5;
      cfg.clock                 = EA_CLOCK_LONDON;
      cfg.serverWinterGmtOffset = P3113_InpServerGmtOffset;
      cfg.maxSpreadPoints       = P3113_InpMaxSpreadPoints;
      cfg.maxCostR              = P3113_InpMaxCostToR;             // frozen cost gate
      cfg.commissionPerLotRT    = 7.00;
      cfg.dailyLossPct          = P3113_InpDailyLossPct;
      cfg.weeklyLossPct         = 2.0;
      cfg.totalDdPct            = P3113_InpTotalDdPct;
      cfg.profitTargetPct       = P3113_InpProfitTargetPct;
      cfg.maxTradesPerDay       = P3113_InpMaxTradesPerDay;
      cfg.maxOpenPositions      = 1;
      cfg.sessionStartHour      = 7;   cfg.sessionStartMin = 0;
      cfg.sessionEndHour        = 16;  cfg.sessionEndMin   = 0;
      cfg.sessionEndFlat        = true;
      cfg.fridayFlat            = true;  cfg.fridayFlatHour = 20;  cfg.fridayFlatMin = 0;
      cfg.signalOnNewBarOnly    = true;
      cfg.pendingExpiryMinutes  = 15;
      cfg.timeStopMinutes       = P3113_InpTimeStopMinutes;        // frozen 45 minutes
      cfg.breakEvenAtR          = 1.0;
      cfg.partial1AtR           = 0.0;                       // V2 removed partial closing
      cfg.useHwmThrottle        = true;
      cfg.hwmTier1Dd            = 2.0;  cfg.hwmTier1Mult = 0.50;
      cfg.hwmTier2Dd            = 5.0;  cfg.hwmTier2Mult = 0.0;  cfg.hwmHaltDd = 5.0;
      cfg.logLevel              = P3113_InpLogLevel;
   }

   bool BuildPlan(SEAContext &ctx, SSignalPlan &plan)
   {
      //--- the frozen contract runs Sleeve A on EURUSD London (active),
      //--- with GBPUSD London and USDJPY New York kept as validated candidates.
      SSweepParams p;
      p.Reset();
      p.rangeFromMin   = 0;
      p.rangeToMin     = 7 * 60;
      p.sessionFromMin = 7 * 60;
      p.sessionToMin   = 11 * 60;
      p.sweepMinAtr    = P3113_InpSweepAtrMin;
      p.sweepMaxAtr    = P3113_InpSweepAtrMax;
      p.reclaimWindowBars = P3113_InpReclaimBars;
      p.wickRatio      = P3113_InpReclaimWickMin;
      p.bodyRatio      = P3113_InpDisplacementBodyMin;
      p.stopBufferAtr  = P3113_InpStopBufferAtr;
      p.minStopAtr     = P3113_InpStopAtrMin;
      p.maxStopAtr     = P3113_InpStopAtrMax;
      p.entryRetrace   = 0.50;
      p.targetR        = P3113_InpProfileTargetR;

      if(ctx.symbol == "USDJPY")
      {
         p.rangeFromMin   = 7 * 60;
         p.rangeToMin     = 13 * 60;
         p.sessionFromMin = 13 * 60 + 30;
         p.sessionToMin   = 16 * 60;
      }
      if(ctx.clockMinutes < p.sessionFromMin || ctx.clockMinutes >= p.sessionToMin) return false;

      if(!SigSweepReclaim(ctx, p, plan)) return false;
      plan.reason = StringFormat("%s %s", P3113_InpBuildId, plan.reason);
      return true;
   }

   void OnInitStrategy()
   {
      EA_Log(EA_LOG_EVENTS, StringFormat("frozen contract build %s - do not change constants without a full revalidation", P3113_InpBuildId));
      EA_Log(EA_LOG_EVENTS, "gold, indices, continuation and Asian fade stay disabled in this contract");
   }
};

