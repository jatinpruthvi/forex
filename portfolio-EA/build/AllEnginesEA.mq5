const string                 P3110_InpSymbolsToTrade          = "EURUSD,GBPUSD,USDJPY";
const double                 P3110_InpMaxSpreadPoints         = 3.0;
const double                 P3110_InpDailyLossPct            = 1.0;
const double                 P3110_InpTotalDdPct              = 10;
const double                 P3110_InpProfitTargetPct         = 10;
const int                    P3110_InpMaxTradesPerDay         = 2;
const int                    P3110_InpServerGmtOffset         = 2;
const ulong                  P3110_InpMagicNumber             = 3110;
