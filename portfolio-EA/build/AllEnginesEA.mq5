//==================================================================
//--- EA_studyarena_round1_contestant_c  (magic 2002, Round 1C - multi-timeframe SMC confluence with exposure cap)
const string                 P2002_InpSymbolsToTrade          = "EURUSD,GBPUSD,USDJPY";
const double                 P2002_InpDailyLossPct            = 5.0;
const double                 P2002_InpTotalDdPct              = 5.0;
const double                 P2002_InpProfitTargetPct         = 20;
const int                    P2002_InpMaxTradesPerDay         = 3;
const int                    P2002_InpServerGmtOffset         = 2;
const ulong                  P2002_InpMagicNumber             = 2002;
const ENUM_EA_LOG_LEVEL      P2002_InpLogLevel                = EA_LOG_EVENTS;
const double                 P2002_InpRiskPerTradePct         = 1.50;
const int                    P2002_InpMaxOpenTrades           = 2;
const double                 P2002_InpMinSlAtr                = 1.00;
const double                 P2002_InpMinRr                   = 2.00;
const double                 P2002_InpAtrSpikeMult            = 1.50;
const int                    P2002_InpConfluenceMin           = 2;

//+------------------------------------------------------------------+
//| Strategy: Round 1C - multi-timeframe SMC confluence with exposure cap
//+------------------------------------------------------------------+
class P2002_CRound1C : public CEAStrategy
{
public:
   void Configure(SEASettings &cfg)
   {
      cfg.strategyName          = "R1C_SMC_CONFLUENCE";
      cfg.sourceDoc             = "docs_v1/docs/coreIdea/studyarena-round1-contestant-c.md";
      cfg.symbols               = P2002_InpSymbolsToTrade;
      cfg.magic                 = P2002_InpMagicNumber;
      cfg.riskPct               = P2002_InpRiskPerTradePct;
      cfg.signalTimeframe       = PERIOD_M15;
      cfg.clock                 = EA_CLOCK_LONDON;
      cfg.serverWinterGmtOffset = P2002_InpServerGmtOffset;
      cfg.dailyLossPct          = P2002_InpDailyLossPct;          // hard stop -5%
      cfg.totalDdPct            = P2002_InpTotalDdPct;            // monthly -5% monthly floor
      cfg.profitTargetPct       = P2002_InpProfitTargetPct;       // auto-close at +20%
      cfg.maxTradesPerDay       = P2002_InpMaxTradesPerDay;
      cfg.maxOpenPositions      = P2002_InpMaxOpenTrades;
      cfg.minSecondsBetweenTrades = 600;
      cfg.sessionStartHour      = 7;   cfg.sessionStartMin = 0;
      cfg.sessionEndHour        = 21;  cfg.sessionEndMin   = 0;
      cfg.fridayFlat            = true;  cfg.fridayFlatHour = 20;  cfg.fridayFlatMin = 0;
      cfg.signalOnNewBarOnly    = true;
      cfg.timeStopMinutes       = 240;
      cfg.breakEvenAtR          = 1.0;
      cfg.logLevel              = P2002_InpLogLevel;
   }

   bool BuildPlan(SEAContext &ctx, SSignalPlan &plan)
   {
      //--- ATR spike filter: ATR(14) must not exceed 1.5x its 30-bar average
      if(AtrIsSpiking(ctx)) return false;

      //--- SMC confluence counter (2 of 3 required): OB retest, break/retest, HTF cascade
      int confluence = 0;
      SCascadeParams cas;
      cas.Reset();
      cas.requireD1 = true; cas.requireH1 = true; cas.requireM15Structure = true;
      int cascade = SigEmaCascade(ctx, cas);
      if(cascade != 0) confluence++;

      SSignalPlan tmp;
      SOrderBlockParams ob;
      ob.Reset();
      ob.lookbackBars = 14; ob.displacementBody = 0.50;
      ob.touchTolAtr = 0.25; ob.targetR = P2002_InpMinRr; ob.requireHtfBias = true;
      bool hasOb = SigOrderBlockRetest(ctx, ob, tmp);
      if(hasOb && (cascade == 0 || (tmp.dir == cascade))) confluence++;

      SBreakRetestParams br;
      br.Reset();
      br.rangeFromMin = 0; br.rangeToMin = 7 * 60;
      br.entryFromMin = 7 * 60; br.entryToMin = 21 * 60;
      br.minRangeAtr = 0.25; br.targetR = P2002_InpMinRr;
      bool hasRetest = SigBreakRetest(ctx, br, tmp);
      if(hasRetest && (cascade == 0 || (tmp.dir == cascade))) confluence++;

      if(confluence < P2002_InpConfluenceMin) return false;

      //--- prefer the order block, fall back to the break/retest plan
      if(hasOb) { if(!SigOrderBlockRetest(ctx, ob, plan)) return false; }
      else      { if(!SigBreakRetest(ctx, br, plan)) return false; }

      //--- dynamic SL: at least 1 x ATR(14), and reward:risk >= 2
      double minStop = P2002_InpMinSlAtr * ctx.atr;
      if(plan.riskDist < minStop)
      {
         plan.stop     = (plan.dir > 0) ? plan.entry - minStop : plan.entry + minStop;
         plan.riskDist = minStop;
         plan.target   = (plan.dir > 0) ? plan.entry + P2002_InpMinRr * minStop
                                        : plan.entry - P2002_InpMinRr * minStop;
      }
      plan.reason = StringFormat("R1C-CONFLUENCE(%d/3) %s", confluence, plan.reason);
      return true;
   }

   bool AtrIsSpiking(SEAContext &ctx)
   {
      double av[];
      if(EA_BufN(g_eaInd[ctx.index].hAtr, 0, 1, 30, av) < 30) return false;
      double sum = 0.0;
      for(int i = 0; i < 30; i++) sum += av[i];
      double avg = sum / 30.0;
      if(avg <= 0.0) return false;
      return (ctx.atr > P2002_InpAtrSpikeMult * avg);
   }
};

