//==================================================================
//--- EA_THE5ERS_HIGH_STAKES_RESEARCH  (magic 3107, The5ers High Stakes research - internal limit ladder + news jurisdiction)
const string                 P3107_InpSymbolsToTrade          = "EURUSD,GBPUSD,USDJPY";
const double                 P3107_InpRiskPct                 = 0.4;
const double                 P3107_InpMaxSpreadPoints         = 3.0;
const double                 P3107_InpDailyLossPct            = 1.0;
const double                 P3107_InpTotalDdPct              = 10;
const int                    P3107_InpMaxTradesPerDay         = 2;
const int                    P3107_InpServerGmtOffset         = 2;
const ulong                  P3107_InpMagicNumber             = 3107;
const ENUM_EA_LOG_LEVEL      P3107_InpLogLevel                = EA_LOG_EVENTS;
const P3107_ENUM_HIGH_STAKES_VARIANT P3107_InpVariant                 = HS_NEW_10PCT;
const double                 P3107_InpWeeklyStopPct           = 2.50;
const double                 P3107_InpShutdownPct             = 5.50;
const double                 P3107_InpMaxOpenRiskPct          = 0.72;
const double                 P3107_InpAbsOpenRiskCapPct       = 1.00;
const bool                   P3107_InpNewsGate                = true;
const int                    P3107_InpNewsBeforeMin           = 30;
const int                    P3107_InpNewsAfterMin            = 30;
const double                 P3107_InpAccountSize             = 2500.0;
const double                 P3107_InpQualifyingDayCash       = 12.50;
const int                    P3107_InpQualifyingDayCount      = 3;

enum P3107_ENUM_HIGH_STAKES_VARIANT
{
   HS_NEW_10PCT     = 0,  // New High Stakes: 10% Phase 1
   HS_CLASSIC_8PCT  = 1   // Classic High Stakes: 8% Phase 1
};

//+------------------------------------------------------------------+
//| Strategy: The5ers High Stakes research - internal limit ladder + news jurisdiction
//+------------------------------------------------------------------+
class P3107_CHighStakesResearch : public CEAStrategy
{
public:
   void Configure(SEASettings &cfg)
   {
      cfg.strategyName          = "HIGH_STAKES_RESEARCH";
      cfg.sourceDoc             = "docs/prop_firm/THE5ERS-HIGH-STAKES-RESEARCH.md";
      cfg.symbols               = P3107_InpSymbolsToTrade;
      cfg.magic                 = P3107_InpMagicNumber;
      cfg.riskPct               = MathMin(P3107_InpRiskPct, P3107_InpMaxOpenRiskPct);   // 0.72% normal cap
      cfg.signalTimeframe       = PERIOD_M15;
      cfg.clock                 = EA_CLOCK_LONDON;
      cfg.serverWinterGmtOffset = P3107_InpServerGmtOffset;
      cfg.serverOffsetAuto      = true;                       // live offset, never hard-coded
      cfg.maxSpreadPoints       = P3107_InpMaxSpreadPoints;
      cfg.dailyLossPct          = P3107_InpDailyLossPct;            // internal 0.75-1.0%
      cfg.weeklyLossPct         = P3107_InpWeeklyStopPct;           // internal 2.0-2.5%
      cfg.totalDdPct            = P3107_InpTotalDdPct;              // 10% firm floor
      cfg.profitTargetPct       = (P3107_InpVariant == HS_CLASSIC_8PCT) ? 8.0 : 10.0;
      cfg.maxTradesPerDay       = P3107_InpMaxTradesPerDay;
      cfg.maxOpenPositions      = 1;                          // bulk trading is prohibited
      cfg.minSecondsBetweenTrades = 300;                      // no tick-scalping profile
      cfg.useHwmThrottle        = true;
      cfg.hwmTier1Dd            = 2.0;  cfg.hwmTier1Mult = 0.50;
      cfg.hwmTier2Dd            = P3107_InpShutdownPct;  cfg.hwmTier2Mult = 0.0;
      cfg.hwmHaltDd             = P3107_InpShutdownPct;             // shutdown/review boundary
      cfg.sessionStartHour      = 7;   cfg.sessionStartMin = 0;
      cfg.sessionEndHour        = 16;  cfg.sessionEndMin   = 0;
      cfg.sessionEndFlat        = true;
      cfg.fridayFlat            = true;  cfg.fridayFlatHour = 21;  cfg.fridayFlatMin = 0;
      cfg.signalOnNewBarOnly    = true;
      cfg.pendingExpiryMinutes  = 15;
      cfg.newsFilter            = P3107_InpNewsGate;                // fail closed when enabled
      cfg.newsFile              = "the5ers_red_news.csv";
      cfg.newsBeforeMin         = P3107_InpNewsBeforeMin;
      cfg.newsAfterMin          = P3107_InpNewsAfterMin;
      cfg.newsFailClosed        = true;                       // bad calendar = no new entries
      cfg.qualifyingDayAmount   = P3107_InpQualifyingDayCash;
      cfg.qualifyingDaysTarget  = P3107_InpQualifyingDayCount;
      cfg.timeStopMinutes       = 45;
      cfg.breakEvenAtR          = 1.0;
      cfg.breakEvenOnBarClose   = true;                    // only a completed bar confirms +1R
      //--- LOCKED: phase-initial balance is the sizing base; one working entry account-wide
      cfg.riskBaseInitialBalance = true;  cfg.riskInitialBalance = P3107_InpAccountSize;
      cfg.oneEntryAccountWide    = true;   // no second entry while one is working or open
      cfg.flattenOnHalt          = true;   // governor halt = cancel entries + close
      cfg.newsFlatBeforeMin      = 15.0;   // flat 15 min before a relevant red event

      cfg.dayAnchorServer        = true;   // firm rollover on the SERVER day, never the clock day
      cfg.dayLockFirstWin        = true;   // any first net-positive exit locks the day

      cfg.dayLockAfterTrades     = 2;      // two completed sequential trades end the day

      cfg.maxRetries           = 1;                        // one revalidated retry only
      cfg.logLevel              = P3107_InpLogLevel;
   }

   bool BuildPlan(SEAContext &ctx, SSignalPlan &plan)
   {
      //--- Sleeve A sweep/reclaim on M15 ATR geometry
      SSweepParams p;
      p.Reset();
      p.rangeFromMin   = 0;
      p.rangeToMin     = 7 * 60;
      p.sessionFromMin = 7 * 60;
      p.sessionToMin   = 16 * 60;
      p.sweepMinAtr    = 0.05;
      p.sweepMaxAtr    = 0.50;
      p.reclaimWindowBars = 3;
      p.wickRatio      = 0.60;
      p.bodyRatio      = 0.60;
      p.stopBufferAtr  = 0.10;
      p.minStopAtr     = 0.60;  p.maxStopAtr = 1.50;
      p.entryRetrace   = 0.50;
      p.targetR        = 1.50;

      if(ctx.symbol == "USDJPY")
      {
         p.rangeFromMin   = 7 * 60;
         p.rangeToMin     = 13 * 60;
         p.sessionFromMin = 13 * 60 + 30;
         p.sessionToMin   = 16 * 60;
      }
      if(ctx.clockMinutes < p.sessionFromMin || ctx.clockMinutes >= p.sessionToMin) return false;

      if(!SigSweepReclaim(ctx, p, plan)) return false;
      plan.reason = StringFormat("HS-RESEARCH %s %s", ctx.symbol, plan.reason);
      return true;
   }

   //--- Section 4 (news): cancel unfilled entries before the blackout and
   //--- suppress retries inside it; Section 3: enforce the absolute open-risk cap.
   void Manage(SEAContext &ctx)
   {
      if(ctx.newsBlocked)
      {
         g_eaExec.CancelPending(ctx.symbol, "news blackout");
         return;
      }
      double openRisk = EA_OpenRiskPct();
      if(openRisk > P3107_InpAbsOpenRiskCapPct)
      {
         EA_Log(EA_LOG_EVENTS, StringFormat("open risk %.2f%% above absolute cap %.2f%% - flattening",
                openRisk, P3107_InpAbsOpenRiskCapPct), true);
         EA_FlattenAll("absolute open-risk cap");
      }
   }
};

